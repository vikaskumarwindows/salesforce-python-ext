# ==============================================================================
# Git Attributes - Line Ending & Binary File Normalization
# ==============================================================================

# Default behavior: auto-normalize text files
* text=auto

# Text files to use LF (Unix line endings)
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.svg text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Windows Shell Scripts to use CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary Files - Prevent corruption or line-ending mangling
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.tar.gz binary
*.wasm binary
*.pdf binary
