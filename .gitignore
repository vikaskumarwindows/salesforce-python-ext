# ==============================================================================
# Git Ignore Configuration - Salesforce & Google Sheet Studio
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / Packaging Outputs
dist/*.zip
dist/*.crx
dist/*.tar.gz
# Keep dist folder structure if .gitkeep is present
!dist/.gitkeep

# C extensions / build artifacts
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pyodide / Local Wasm Cache (if downloaded locally)
*.wasm
!extension/pyodide/*.wasm

# Node & Package Managers (if ever used)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configuration
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Temporary and backup files
*.bak
*.tmp
*.temp
*.log
